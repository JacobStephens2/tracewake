# The instance file, as Educational Travel Adventures runs it.
#
# Copy this, change every value, and point the units at it. Nothing here has a
# default in Tracewake's code: each line names a host, a person, a database or
# a command that has exactly one right answer per instance and no right answer
# in the product (issue #3). A value left out stops the cycle at preflight with
# the variable named, before the tracker is read.
#
# No secret belongs in this file. The GitHub token lives on the box, in the
# file a target's `token_file` names; the model credential is minted on the box
# by a wizard; the mail relay's credential belongs to whatever
# SELECTOR_NOTIFY_COMMAND runs. What is here is addresses and paths.

# --- The targets ------------------------------------------------------------
# The one variable that cannot live in a file of its own.
TRACEWAKE_TARGETS_FILE=/etc/tracewake/targets.toml

# --- The Journal ------------------------------------------------------------
# Postgres, on the controller, over the unix socket under peer auth. The
# product's own default (`dbname=selector`) is a database name rather than a
# host, so it is one of the few things that does have one; ETA sets it anyway,
# because a controller that grew a second instance would need to.
SELECTOR_JOURNAL_DSN=dbname=selector

# --- The box ----------------------------------------------------------------
# Where Runs execute. ETA's box is a separate droplet from the controller,
# deliberately: the controller holds production database grants and the vault
# token, and an unattended agent must not be one compromise away from those
# (ADR 0003, ADR 0009). `examples/droplet.tf` is the resource.
SELECTOR_BOX_HOST=root@loop.etadventures.com
SELECTOR_BOX_USER=loop
SELECTOR_BOX_LOOP=/home/loop/loop
SELECTOR_BOX_AGENT=claude

# --- The window -------------------------------------------------------------
# Where this instance publishes its board. It is what the notifier links to,
# so it is the address a person will click out of an email.
SELECTOR_LOOP_URL=https://lab.etadventures.com/loop

# --- The mail surface -------------------------------------------------------
# One command: the subject on argv, the body on stdin, an optional link as the
# second argument. Tracewake knows nothing about mailers - this one is a shim
# in ETA's own tree that hands the message to the status dashboard's mailer,
# and swapping relays is a change to that script and to nothing here
# (ADR 0004, ADR 0018).
SELECTOR_NOTIFY_COMMAND=/srv/orchestration/scripts/selector-notify.sh

# --- The guardrail ----------------------------------------------------------
# The write protection standing over the paths that run unattended: the rules
# GitHub holds on the ref they are deployed from, and whether the deployed tree
# still matches it. ETA runs a pinned checkout of the product, so the ref is
# the product's own.
SELECTOR_PROTECTED_REPO=JacobStephens2/tracewake
SELECTOR_PROTECTED_REF=main
SELECTOR_PROTECTED_TREE=/srv/tracewake

#!/usr/bin/env bash
#
# git's credential helper for github.com on the Loop's box.
#
# git calls this with `get`, `store` or `erase` on argv[1] and a request on
# stdin. Only `get` does anything: the token is placed by a human running
# wizards/loop-github-credentials.sh, and a helper that could write it would be
# a second, unaudited way for a credential to arrive on this box.
#
# Printing nothing when the token is absent is deliberate. git then fails the
# push with an authentication error, which is a Run that stops - the right
# direction. The alternative, prompting, would hang an unattended Iteration
# until its wall clock killed it and cost the whole Iteration to say the same
# thing.

set -euo pipefail

token_file="${LOOP_GITHUB_TOKEN_FILE:-/home/loop/.config/loop/github-token}"

[[ ${1:-} == "get" ]] || exit 0
[[ -s ${token_file} ]] || exit 0

printf 'username=x-access-token\n'
printf 'password=%s\n' "$(tr -d '\r\n' <"${token_file}")"

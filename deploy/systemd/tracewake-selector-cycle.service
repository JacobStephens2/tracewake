[Unit]
Description=One Selector cycle: pick and dispatch the lowest eligible handed-over issue
Documentation=https://github.com/JacobStephens2/tracewake/blob/main/selector/README.md
After=network-online.target postgresql.service
Wants=network-online.target
# The Journal is not optional: a cycle that cannot append cannot hold its own
# in-flight lock or read its own spend, so it must not run at all.
Requires=postgresql.service

# In [Unit], NOT [Service]. systemd silently ignores OnFailure= in [Service] -
# it logs `Unknown key name 'OnFailure' in section 'Service', ignoring` and the
# unit otherwise looks perfectly configured.
#
# Story 31 is what this line is for: the Selector's own failures - a tracker
# that did not answer, a Seeding refusal, a box that started no Run, a label
# swap GitHub rejected - have to reach the operator, because a dead Selector
# and a quiet queue look identical from the dashboard.
#
# Verify rather than trust:
#     systemctl show tracewake-selector-cycle.service -p OnFailure --value
# Empty output means the directive did not register.
OnFailure={{ tracewake_on_failure | default('notify-unit-failure@%n.service') }}

[Service]
Type=oneshot
User={{ tracewake_user | default('conductor') }}
Group={{ tracewake_group | default('conductor') }}
WorkingDirectory={{ tracewake_dir | default('/srv/tracewake') }}/selector

# Through the instance's environment file. A systemd unit starts with an empty
# environment, and the tracker command is `gh api graphql` - which without
# GH_TOKEN fails as an authentication error on every cycle, forever, while the
# unit itself looks healthy.
EnvironmentFile=-{{ tracewake_env_file | default('/etc/tracewake/tracewake.env') }}
{% for env in tracewake_extra_env_files | default([]) %}
EnvironmentFile=-{{ env }}
{% endfor %}

# The interpreter is named explicitly rather than relying on the shebang.
# Passing the script as an argument means it only has to be readable.
#
# If an instance resolves its environment through a wrapper script (e.g.
# an op-inject launcher), that wrapper is set via tracewake_cycle_wrapper.
ExecStart={{ (tracewake_cycle_wrapper ~ ' ') if tracewake_cycle_wrapper | default('') else '' }}{{ tracewake_dir | default('/srv/tracewake') }}/selector/.venv/bin/python \
    {{ tracewake_dir | default('/srv/tracewake') }}/selector/cycle.py{{ (' ' ~ tracewake_cycle_args) if tracewake_cycle_args | default('') else '' }}

# A dispatching cycle holds the process for the length of the Run. The
# Termination Contract bounds a Run at 90 minutes and the Selector's own
# backstop (SELECTOR_DISPATCH_TIMEOUT_SECONDS) at 7200s, so this is above both
# on purpose: it is the last resort for a cycle that wedged somewhere with no
# timeout of its own, and a number that could fire FIRST would be a bound on
# Runs that nothing in contract.sh declared.
TimeoutStartSec=8100

# Two cycles never run at once - cycle.py takes a Postgres advisory lock and a
# second one stands down, exit 0. This is belt and braces for the ordinary
# case: with a 30-minute timer and a 90-minute Run, the timer fires two or
# three times into a Run that is still going, and systemd refusing to start a
# second instance of a oneshot that is still activating keeps those firings
# from even reaching Python.

[Install]
WantedBy=multi-user.target

[Unit]
Description=Tracewake's window — FastAPI + Jinja2 + HTMX
After=network.target postgresql.service

[Service]
User={{ tracewake_user }}
Group={{ tracewake_group }}
WorkingDirectory={{ tracewake_dir }}/web
ExecStart={{ tracewake_dir }}/web/.venv/bin/uvicorn app:app --host 127.0.0.1 --port {{ tracewake_web_port }}{% if tracewake_web_reload | default(false) | bool %} --reload{% endif %}

EnvironmentFile=-{{ tracewake_env_file }}
{% for env in tracewake_extra_env_files %}
EnvironmentFile=-{{ env }}
{% endfor %}
Environment=PATH={{ tracewake_user_home }}/.local/bin:/usr/local/bin:/usr/bin:/bin

Restart=on-failure
RestartSec=3
# hardening: read-only system, writable nowhere it doesn't need
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target

[Unit]
Description=Tracewake's window — FastAPI + Jinja2 + HTMX
After=network.target postgresql.service

[Service]
User={{ tracewake_user }}
Group={{ tracewake_group }}
WorkingDirectory={{ tracewake_dir }}/web
ExecStart={{ tracewake_dir }}/web/.venv/bin/uvicorn app:app --host 127.0.0.1 --port {{ tracewake_web_port }}

EnvironmentFile=-{{ tracewake_env_file }}
{% for env in tracewake_extra_env_files %}
EnvironmentFile=-{{ env }}
{% endfor %}
Environment=PATH={{ tracewake_user_home }}/.local/bin:/usr/local/bin:/usr/bin:/bin

Restart=on-failure
RestartSec=3
# ProtectSystem and PrivateTmp stay. NoNewPrivileges does not: the window
# toggles the cycle timer through `sudo -n systemctl` (see
# /etc/sudoers.d/tracewake-timer), and that flag makes sudo refuse to run
# as root before the sudoers rule is consulted, with a warning about
# containers.
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target

[Unit]
Description=Tracewake's window — FastAPI + Jinja2 + HTMX
After=network.target postgresql.service

[Service]
User={{ tracewake_user | default('conductor') }}
Group={{ tracewake_group | default('conductor') }}
WorkingDirectory={{ tracewake_dir | default('/srv/tracewake') }}/web
ExecStart={{ tracewake_dir | default('/srv/tracewake') }}/web/.venv/bin/uvicorn app:app --host 127.0.0.1 --port {{ tracewake_web_port | default(8100) }}

EnvironmentFile=-{{ tracewake_env_file | default('/etc/tracewake/tracewake.env') }}
{% for env in tracewake_extra_env_files | default([]) %}
EnvironmentFile=-{{ env }}
{% endfor %}
Environment=PATH={{ tracewake_user_home | default('/home/' ~ (tracewake_user | default('conductor'))) }}/.local/bin:/usr/local/bin:/usr/bin:/bin

Restart=on-failure
RestartSec=3
# hardening: read-only system, writable nowhere it doesn't need
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target

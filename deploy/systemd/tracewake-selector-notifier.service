[Unit]
Description=Email the operator about the Loop's Runs, failures and credential expiry
Documentation=https://github.com/JacobStephens2/tracewake/blob/main/selector/README.md
After=network-online.target postgresql.service
Wants=network-online.target
# The Journal is the whole input. Without it there is nothing to listen to and
# nowhere to record what has been delivered, so this must not run at all.
Requires=postgresql.service

# In [Unit], NOT [Service] - systemd silently ignores OnFailure= in [Service]
# and the unit otherwise looks perfectly configured. Verify rather than trust:
#     systemctl show tracewake-selector-notifier.service -p OnFailure --value
#
# What this catches is the notifier's own failure, and it is the one alert on
# this box that must not go through the notifier: a relay that refused is
# exactly the case where the Loop's own mail is not arriving.
OnFailure={{ tracewake_on_failure | default('notify-unit-failure@%n.service') }}

# In [Unit] as well, and for the same class of reason: these two moved out of
# [Service] in systemd 229 and are ignored there. They are what stops a
# permanently misconfigured relay from restarting every ten seconds forever in
# silence - after ten failures inside ten minutes the unit ends in `failed`,
# which is what the OnFailure above is waiting for.
#     systemctl show tracewake-selector-notifier.service -p StartLimitBurst --value
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
User={{ tracewake_user | default('conductor') }}
Group={{ tracewake_group | default('conductor') }}
WorkingDirectory={{ tracewake_dir | default('/srv/tracewake') }}/selector

EnvironmentFile=-{{ tracewake_env_file | default('/etc/tracewake/tracewake.env') }}
{% for env in tracewake_extra_env_files | default([]) %}
EnvironmentFile=-{{ env }}
{% endfor %}

# The interpreter is named explicitly rather than relying on the shebang.
# Passing the script as an argument means it only has to be readable.
ExecStart={{ tracewake_dir | default('/srv/tracewake') }}/selector/.venv/bin/python \
    {{ tracewake_dir | default('/srv/tracewake') }}/selector/notifier.py

# A refused delivery exits non-zero on purpose, with the cursor left where it
# was, so restarting IS the retry. Ten seconds because the usual cause is a
# relay that is briefly unhappy; the start limit in [Unit] is what bounds it.
Restart=always
RestartSec=10s

[Install]
WantedBy=multi-user.target
